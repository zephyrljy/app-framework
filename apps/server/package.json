{
  "name": "@app/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch --env-file=../../deploy/.env.local src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "NODE_OPTIONS=--conditions=development tsx --env-file=../../deploy/.env.local src/scripts/migrate.ts",
    "test": "NODE_OPTIONS=--conditions=development tsx --env-file=../../deploy/.env.test --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.1",
    "@fastify/compress": "^9.2.1",
    "@fastify/env": "^7.0.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.2.0",
    "@fastify/under-pressure": "^9.2.1",
    "@app/contracts": "workspace:*",
    "ajv-formats": "^3.0.1",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.1",
    "mysql2": "^3.24.5",
    "postgrator": "^8.0.0",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "fastify-tsconfig": "^3.0.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
